# Copy this file to .env.local and fill in YOUR OWN values. Never share the real file.

# --- Required: your database (Supabase) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
APP_URL=https://timeclock.example.com
APP_PIN_SECRET=any-long-random-text

# --- Optional: shared login from another app (leave blank to use this app's own login) ---
VITE_CENTRAL_AUTH_URL=
VITE_CENTRAL_AUTH_ANON_KEY=
CENTRAL_AUTH_URL=

# --- Optional: payroll sync (Gusto) ---
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
GUSTO_API_BASE=https://api.gusto.com
GUSTO_API_VERSION=

# --- Optional: text messages (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Optional: email (Resend) ---
RESEND_API_KEY=
RESEND_FROM="Team Time Clock <timeclock@example.com>"

# --- Optional: who gets admin notices (Gusto sync changes, alerts). Comma-separate several. ---
OWNER_NOTIFY_EMAIL=

# --- Optional: team chat notices ---
TEAM_CHAT_GATEWAY_URL=
TEAM_CHAT_API_KEY=
TEAM_CHAT_TOKEN=

# --- Optional: salon booking system (Boulevard) ---
BLVD_API_KEY=
BLVD_SECRET_KEY=
BLVD_BUSINESS_ID=

# --- Optional: keys other apps use to read hours from this one ---
HOURS_API_KEY=
TIMEKEEPING_API_KEY=
KPI_SENTINEL_API_KEY=
